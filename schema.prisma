model AuditEvent {
  id              String                  @id @default(cuid())
  business        Business?               @relation("AuditEvent_business", fields: [businessId], references: [id])
  businessId      String?                 @map("business")
  store           Store?                  @relation("AuditEvent_store", fields: [storeId], references: [id])
  storeId         String?                 @map("store")
  eventNumber     String                  @unique @default("")
  action          String                  @default("")
  resourceType    String                  @default("")
  resourceId      String                  @default("")
  result          AuditEventResultType
  actorType       AuditEventActorTypeType
  actorUser       User?                   @relation("AuditEvent_actorUser", fields: [actorUserId], references: [id])
  actorUserId     String?                 @map("actorUser")
  actorEmployee   Employee?               @relation("AuditEvent_actorEmployee", fields: [actorEmployeeId], references: [id])
  actorEmployeeId String?                 @map("actorEmployee")
  actorApiKey     ApiKey?                 @relation("AuditEvent_actorApiKey", fields: [actorApiKeyId], references: [id])
  actorApiKeyId   String?                 @map("actorApiKey")
  requestId       String                  @default("")
  idempotency     IdempotencyKey?         @relation("AuditEvent_idempotency", fields: [idempotencyId], references: [id])
  idempotencyId   String?                 @map("idempotency")
  changes         Json?
  sourceIpDigest  String                  @default("")
  userAgent       String                  @default("")
  occurredAt      DateTime                @default(now())
  metadata        Json?                   @default("{}")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @default(now()) @updatedAt

  @@index([businessId])
  @@index([storeId])
  @@index([action])
  @@index([resourceType])
  @@index([resourceId])
  @@index([actorUserId])
  @@index([actorEmployeeId])
  @@index([actorApiKeyId])
  @@index([requestId])
  @@index([idempotencyId])
}

model WebhookEvent {
  id                String                 @id @default(cuid())
  business          Business?              @relation("WebhookEvent_business", fields: [businessId], references: [id])
  businessId        String?                @map("business")
  paymentProvider   PaymentProvider?       @relation("WebhookEvent_paymentProvider", fields: [paymentProviderId], references: [id])
  paymentProviderId String?                @map("paymentProvider")
  externalEventId   String                 @default("")
  lookupKey         String                 @unique @default("")
  eventType         String                 @default("")
  payloadDigest     String                 @default("")
  status            WebhookEventStatusType @default(received)
  attemptCount      Int                    @default(0)
  receivedAt        DateTime               @default(now())
  processedAt       DateTime?
  lastError         String                 @default("")
  idempotency       IdempotencyKey?        @relation("WebhookEvent_idempotency", fields: [idempotencyId], references: [id])
  idempotencyId     String?                @map("idempotency")
  metadata          Json?                  @default("{}")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @default(now()) @updatedAt

  @@index([businessId])
  @@index([paymentProviderId])
  @@index([externalEventId])
  @@index([eventType])
  @@index([idempotencyId])
}

