model PaymentProvider {
  id                                         String                    @id @default(cuid())
  business                                   Business?                 @relation("PaymentProvider_business", fields: [businessId], references: [id])
  businessId                                 String?                   @map("business")
  name                                       String                    @default("")
  code                                       String                    @default("")
  lookupKey                                  String                    @unique @default("")
  status                                     PaymentProviderStatusType @default(configured)
  adapterKey                                 String                    @default("")
  createPaymentFunction                      String                    @default("manual")
  capturePaymentFunction                     String                    @default("manual")
  refundPaymentFunction                      String                    @default("manual")
  getPaymentStatusFunction                   String                    @default("manual")
  handleWebhookFunction                      String                    @default("manual")
  credentialReference                        String                    @default("")
  configuration                              Json?                     @default("{}")
  tenders                                    Tender[]                  @relation("Tender_paymentProvider")
  metadata                                   Json?                     @default("{}")
  createdAt                                  DateTime                  @default(now())
  updatedAt                                  DateTime                  @default(now()) @updatedAt
  from_PaymentReconciliation_paymentProvider PaymentReconciliation[]   @relation("PaymentReconciliation_paymentProvider")
  from_WebhookEvent_paymentProvider          WebhookEvent[]            @relation("WebhookEvent_paymentProvider")

  @@index([businessId])
  @@index([code])
}

model PaymentReconciliation {
