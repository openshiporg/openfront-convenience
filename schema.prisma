model OutboxAttempt {
  id            String                   @id @default(cuid())
  business      Business?                @relation("OutboxAttempt_business", fields: [businessId], references: [id])
  businessId    String?                  @map("business")
  store         Store?                   @relation("OutboxAttempt_store", fields: [storeId], references: [id])
  storeId       String?                  @map("store")
  event         OutboxEvent?             @relation("OutboxAttempt_event", fields: [eventId], references: [id])
  eventId       String?                  @map("event")
  attemptKey    String                   @unique @default("")
  attemptNumber Int
  workerId      String                   @default("")
  outcome       OutboxAttemptOutcomeType @default(processing)
  startedAt     DateTime
  finishedAt    DateTime?
  error         String                   @default("")
  metadata      Json?                    @default("{}")
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @default(now()) @updatedAt

  @@index([businessId])
  @@index([storeId])
  @@index([eventId])
  @@index([workerId])
  @@index([outcome])
}

model ApiKey {
  id                              String           @id @default(cuid())
  business                        Business?        @relation("ApiKey_business", fields: [businessId], references: [id])
  businessId                      String?          @map("business")
  name                            String           @default("")
  keyPrefix                       String           @unique @default("")
  lookupKey                       String           @unique @default("")
  secretHash                      String
  status                          ApiKeyStatusType @default(active)
  scopes                          Json?            @default("[]")
  allStores                       Boolean          @default(false)
  stores                          Store[]          @relation("ApiKey_stores")
  createdBy                       User?            @relation("ApiKey_createdBy", fields: [createdById], references: [id])
  createdById                     String?          @map("createdBy")
  expiresAt                       DateTime?
  revokedAt                       DateTime?
  lastUsedAt                      DateTime?
  failedAuthCount                 Int              @default(0)
  failedAuthResetAt               DateTime?
  metadata                        Json?            @default("{}")
  createdAt                       DateTime         @default(now())
  updatedAt                       DateTime         @default(now()) @updatedAt
  from_OfflineDevice_apiKey       OfflineDevice[]  @relation("OfflineDevice_apiKey")
  from_IdempotencyKey_actorApiKey IdempotencyKey[] @relation("IdempotencyKey_actorApiKey")
  from_AuditEvent_actorApiKey     AuditEvent[]     @relation("AuditEvent_actorApiKey")

  @@index([businessId])
  @@index([createdById])
}

