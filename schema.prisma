model InventoryTransfer {
  id                    String                      @id @default(cuid())
  business              Business?                   @relation("InventoryTransfer_business", fields: [businessId], references: [id])
  businessId            String?                     @map("business")
  transferNumber        String                      @unique @default("")
  status                InventoryTransferStatusType @default(draft)
  sourceStore           Store?                      @relation("InventoryTransfer_sourceStore", fields: [sourceStoreId], references: [id])
  sourceStoreId         String?                     @map("sourceStore")
  destinationStore      Store?                      @relation("InventoryTransfer_destinationStore", fields: [destinationStoreId], references: [id])
  destinationStoreId    String?                     @map("destinationStore")
  sourceLocation        InventoryLocation?          @relation("InventoryTransfer_sourceLocation", fields: [sourceLocationId], references: [id])
  sourceLocationId      String?                     @map("sourceLocation")
  destinationLocation   InventoryLocation?          @relation("InventoryTransfer_destinationLocation", fields: [destinationLocationId], references: [id])
  destinationLocationId String?                     @map("destinationLocation")
  lines                 InventoryTransferLine[]     @relation("InventoryTransferLine_transfer")
  requestedBy           Employee?                   @relation("InventoryTransfer_requestedBy", fields: [requestedById], references: [id])
  requestedById         String?                     @map("requestedBy")
  approvedBy            Employee?                   @relation("InventoryTransfer_approvedBy", fields: [approvedById], references: [id])
  approvedById          String?                     @map("approvedBy")
  shippedBy             Employee?                   @relation("InventoryTransfer_shippedBy", fields: [shippedById], references: [id])
  shippedById           String?                     @map("shippedBy")
  receivedBy            Employee?                   @relation("InventoryTransfer_receivedBy", fields: [receivedById], references: [id])
  receivedById          String?                     @map("receivedBy")
  requestedAt           DateTime                    @default(now())
  approvedAt            DateTime?
  shippedAt             DateTime?
  receivedAt            DateTime?
  cancelledAt           DateTime?
  notes                 String                      @default("")
  idempotency           IdempotencyKey?             @relation("InventoryTransfer_idempotency", fields: [idempotencyId], references: [id])
  idempotencyId         String?                     @map("idempotency")
  metadata              Json?                       @default("{}")
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @default(now()) @updatedAt

  @@index([businessId])
  @@index([status])
  @@index([sourceStoreId])
  @@index([destinationStoreId])
  @@index([sourceLocationId])
  @@index([destinationLocationId])
  @@index([requestedById])
  @@index([approvedById])
  @@index([shippedById])
  @@index([receivedById])
  @@index([idempotencyId])
}

model InventoryTransferLine {
  id                String                           @id @default(cuid())
  business          Business?                        @relation("InventoryTransferLine_business", fields: [businessId], references: [id])
  businessId        String?                          @map("business")
  transfer          InventoryTransfer?               @relation("InventoryTransferLine_transfer", fields: [transferId], references: [id])
  transferId        String?                          @map("transfer")
  variant           ProductVariant?                  @relation("InventoryTransferLine_variant", fields: [variantId], references: [id])
  variantId         String?                          @map("variant")
  lineNumber        Int
  skuSnapshot       String                           @default("")
  titleSnapshot     String                           @default("")
  quantityRequested Decimal                          @postgresql.Decimal(18, 4)
  quantityShipped   Decimal                          @default("0.0000") @postgresql.Decimal(18, 4)
  quantityReceived  Decimal                          @default("0.0000") @postgresql.Decimal(18, 4)
  allocations       InventoryTransferLotAllocation[] @relation("InventoryTransferLotAllocation_line")
  metadata          Json?                            @default("{}")
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @default(now()) @updatedAt

  @@index([businessId])
  @@index([transferId])
  @@index([variantId])
}

model InventoryTransferLotAllocation {
  id                String                 @id @default(cuid())
  business          Business?              @relation("InventoryTransferLotAllocation_business", fields: [businessId], references: [id])
  businessId        String?                @map("business")
  line              InventoryTransferLine? @relation("InventoryTransferLotAllocation_line", fields: [lineId], references: [id])
  lineId            String?                @map("line")
  sourceLot         InventoryLot?          @relation("InventoryTransferLotAllocation_sourceLot", fields: [sourceLotId], references: [id])
  sourceLotId       String?                @map("sourceLot")
  destinationLot    InventoryLot?          @relation("InventoryTransferLotAllocation_destinationLot", fields: [destinationLotId], references: [id])
  destinationLotId  String?                @map("destinationLot")
  allocationKey     String                 @unique @default("")
  quantity          Decimal                @postgresql.Decimal(18, 4)
  lotNumberSnapshot String                 @default("")
  expiresAtSnapshot DateTime?
  unitCostCents     Int                    @default(0)
  metadata          Json?                  @default("{}")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @default(now()) @updatedAt

  @@index([businessId])
  @@index([lineId])
  @@index([sourceLotId])
  @@index([destinationLotId])
}

model Vendor {
  id                       String                @id @default(cuid())
  business                 Business?             @relation("Vendor_business", fields: [businessId], references: [id])
  businessId               String?               @map("business")
  name                     String                @default("")
  vendorNumber             String                @default("")
  lookupKey                String                @unique @default("")
  status                   VendorStatusType      @default(active)
  contactName              String                @default("")
  email                    String                @default("")
  phone                    String                @default("")
  website                  String                @default("")
  paymentTerms             VendorPaymentTermType @default(net_30)
  leadTimeDays             Int?                  @default(0)
  minimumOrderCents        Int                   @default(0)
  notes                    String                @default("")
  items                    VendorItem[]          @relation("VendorItem_vendor")
  purchaseOrders           PurchaseOrder[]       @relation("PurchaseOrder_vendor")
  metadata                 Json?                 @default("{}")
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @default(now()) @updatedAt
  from_InventoryLot_vendor InventoryLot[]        @relation("InventoryLot_vendor")
  from_Receiving_vendor    Receiving[]           @relation("Receiving_vendor")
  from_FuelDelivery_vendor FuelDelivery[]        @relation("FuelDelivery_vendor")

  @@index([businessId])
  @@index([vendorNumber])
}

model VendorItem {
  id                 String               @id @default(cuid())
  business           Business?            @relation("VendorItem_business", fields: [businessId], references: [id])
  businessId         String?              @map("business")
  vendor             Vendor?              @relation("VendorItem_vendor", fields: [vendorId], references: [id])
  vendorId           String?              @map("vendor")
  variant            ProductVariant?      @relation("VendorItem_variant", fields: [variantId], references: [id])
  variantId          String?              @map("variant")
  vendorSku          String               @default("")
  lookupKey          String               @unique @default("")
  status             VendorItemStatusType @default(active)
  casePackQuantity   Decimal              @default("1.0000") @postgresql.Decimal(18, 4)
  unitsPerCase       Int?                 @default(1)
  unitCostCents      Int                  @default(0)
  leadTimeDays       Int?                 @default(0)
  purchaseOrderLines PurchaseOrderLine[]  @relation("PurchaseOrderLine_vendorItem")
  metadata           Json?                @default("{}")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt

  @@index([businessId])
  @@index([vendorId])
  @@index([variantId])
  @@index([vendorSku])
}

model PurchaseOrder {
  id            String                  @id @default(cuid())
  business      Business?               @relation("PurchaseOrder_business", fields: [businessId], references: [id])
  businessId    String?                 @map("business")
  store         Store?                  @relation("PurchaseOrder_store", fields: [storeId], references: [id])
  storeId       String?                 @map("store")
  vendor        Vendor?                 @relation("PurchaseOrder_vendor", fields: [vendorId], references: [id])
  vendorId      String?                 @map("vendor")
  poNumber      String                  @unique @default("")
  status        PurchaseOrderStatusType @default(draft)
  currencyCode  String                  @default("USD")
  subtotalCents Int                     @default(0)
  taxCents      Int                     @default(0)
  shippingCents Int                     @default(0)
  totalCents    Int                     @default(0)
  orderedAt     DateTime?
  expectedAt    DateTime?
  submittedAt   DateTime?
  approvedAt    DateTime?
  cancelledAt   DateTime?
  createdBy     Employee?               @relation("PurchaseOrder_createdBy", fields: [createdById], references: [id])
  createdById   String?                 @map("createdBy")
  approvedBy    Employee?               @relation("PurchaseOrder_approvedBy", fields: [approvedById], references: [id])
  approvedById  String?                 @map("approvedBy")
  lines         PurchaseOrderLine[]     @relation("PurchaseOrderLine_purchaseOrder")
  receivings    Receiving[]             @relation("Receiving_purchaseOrder")
  notes         String                  @default("")
  metadata      Json?                   @default("{}")
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @default(now()) @updatedAt

  @@index([businessId])
  @@index([storeId])
  @@index([vendorId])
  @@index([createdById])
  @@index([approvedById])
}

model PurchaseOrderLine {
  id                  String          @id @default(cuid())
  business            Business?       @relation("PurchaseOrderLine_business", fields: [businessId], references: [id])
  businessId          String?         @map("business")
  store               Store?          @relation("PurchaseOrderLine_store", fields: [storeId], references: [id])
  storeId             String?         @map("store")
  purchaseOrder       PurchaseOrder?  @relation("PurchaseOrderLine_purchaseOrder", fields: [purchaseOrderId], references: [id])
  purchaseOrderId     String?         @map("purchaseOrder")
  vendorItem          VendorItem?     @relation("PurchaseOrderLine_vendorItem", fields: [vendorItemId], references: [id])
  vendorItemId        String?         @map("vendorItem")
  variant             ProductVariant? @relation("PurchaseOrderLine_variant", fields: [variantId], references: [id])
  variantId           String?         @map("variant")
  descriptionSnapshot String          @default("")
  vendorSkuSnapshot   String          @default("")
  quantityOrdered     Decimal         @postgresql.Decimal(18, 4)
  quantityReceived    Decimal         @default("0.0000") @postgresql.Decimal(18, 4)
  quantityCancelled   Decimal         @default("0.0000") @postgresql.Decimal(18, 4)
  unitCostCents       Int
  lineTotalCents      Int
  receivingLines      ReceivingLine[] @relation("ReceivingLine_purchaseOrderLine")
  notes               String          @default("")
  metadata            Json?           @default("{}")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @default(now()) @updatedAt

  @@index([businessId])
  @@index([storeId])
  @@index([purchaseOrderId])
  @@index([vendorItemId])
  @@index([variantId])
}

model Receiving {
  id                   String              @id @default(cuid())
  business             Business?           @relation("Receiving_business", fields: [businessId], references: [id])
  businessId           String?             @map("business")
  store                Store?              @relation("Receiving_store", fields: [storeId], references: [id])
  storeId              String?             @map("store")
  purchaseOrder        PurchaseOrder?      @relation("Receiving_purchaseOrder", fields: [purchaseOrderId], references: [id])
