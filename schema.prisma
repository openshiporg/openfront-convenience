  vendor               Vendor?             @relation("Receiving_vendor", fields: [vendorId], references: [id])
  vendorId             String?             @map("vendor")
  receivingNumber      String              @unique @default("")
  vendorDocumentNumber String              @default("")
  status               ReceivingStatusType @default(draft)
  receivedAt           DateTime?
  postedAt             DateTime?
  receivedBy           Employee?           @relation("Receiving_receivedBy", fields: [receivedById], references: [id])
  receivedById         String?             @map("receivedBy")
  lines                ReceivingLine[]     @relation("ReceivingLine_receiving")
  discrepancyNotes     String              @default("")
  metadata             Json?               @default("{}")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @default(now()) @updatedAt

  @@index([businessId])
  @@index([storeId])
  @@index([purchaseOrderId])
  @@index([vendorId])
  @@index([vendorDocumentNumber])
  @@index([receivedById])
}

model ReceivingLine {
  id                  String                           @id @default(cuid())
  business            Business?                        @relation("ReceivingLine_business", fields: [businessId], references: [id])
  businessId          String?                          @map("business")
  store               Store?                           @relation("ReceivingLine_store", fields: [storeId], references: [id])
  storeId             String?                          @map("store")
  receiving           Receiving?                       @relation("ReceivingLine_receiving", fields: [receivingId], references: [id])
  receivingId         String?                          @map("receiving")
  purchaseOrderLine   PurchaseOrderLine?               @relation("ReceivingLine_purchaseOrderLine", fields: [purchaseOrderLineId], references: [id])
  purchaseOrderLineId String?                          @map("purchaseOrderLine")
  variant             ProductVariant?                  @relation("ReceivingLine_variant", fields: [variantId], references: [id])
  variantId           String?                          @map("variant")
  quantityExpected    Decimal                          @default("0.0000") @postgresql.Decimal(18, 4)
  quantityAccepted    Decimal                          @default("0.0000") @postgresql.Decimal(18, 4)
  quantityRejected    Decimal                          @default("0.0000") @postgresql.Decimal(18, 4)
  rejectionReason     ReceivingLineRejectionReasonType @default(none)
  unitCostCents       Int
  notes               String                           @default("")
  lots                InventoryLot[]                   @relation("InventoryLot_receivingLine")
  inventoryEntries    InventoryLedgerEntry[]           @relation("InventoryLedgerEntry_receivingLine")
  metadata            Json?                            @default("{}")
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @default(now()) @updatedAt

  @@index([businessId])
  @@index([storeId])
  @@index([receivingId])
  @@index([purchaseOrderLineId])
  @@index([variantId])
}

model Cart {
  id                        String            @id @default(cuid())
  business                  Business?         @relation("Cart_business", fields: [businessId], references: [id])
  businessId                String?           @map("business")
  store                     Store?            @relation("Cart_store", fields: [storeId], references: [id])
  storeId                   String?           @map("store")
  cartNumber                String            @unique @default("")
  source                    CartSourceType    @default(pos)
  status                    CartStatusType    @default(open)
  currencyCode              String            @default("USD")
  subtotalCents             Int               @default(0)
  discountCents             Int               @default(0)
  taxCents                  Int               @default(0)
  totalCents                Int               @default(0)
  loyaltyPointsToRedeem     Int               @default(0)
  loyaltyRedemptionCents    Int               @default(0)
  registerSession           RegisterSession?  @relation("Cart_registerSession", fields: [registerSessionId], references: [id])
  registerSessionId         String?           @map("registerSession")
  cashier                   Employee?         @relation("Cart_cashier", fields: [cashierId], references: [id])
  cashierId                 String?           @map("cashier")
  customer                  User?             @relation("Cart_customer", fields: [customerId], references: [id])
  customerId                String?           @map("customer")
  loyaltyAccount            LoyaltyAccount?   @relation("Cart_loyaltyAccount", fields: [loyaltyAccountId], references: [id])
  loyaltyAccountId          String?           @map("loyaltyAccount")
  priceBook                 PriceBook?        @relation("Cart_priceBook", fields: [priceBookId], references: [id])
  priceBookId               String?           @map("priceBook")
  guestTokenDigest          String            @default("")
  expiresAt                 DateTime?
  lines                     CartLine[]        @relation("CartLine_cart")
  promotions                Promotion[]       @relation("Cart_promotions")
  sale                      Sale?             @relation("Cart_sale", fields: [saleId], references: [id])
  saleId                    String?           @unique @map("sale")
  metadata                  Json?             @default("{}")
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @default(now()) @updatedAt
  from_AgeVerification_cart AgeVerification[] @relation("AgeVerification_cart")

  @@index([businessId])
  @@index([storeId])
  @@index([registerSessionId])
  @@index([cashierId])
  @@index([customerId])
  @@index([loyaltyAccountId])
  @@index([priceBookId])
  @@index([guestTokenDigest])
}

model CartLine {
  id                   String                  @id @default(cuid())
  business             Business?               @relation("CartLine_business", fields: [businessId], references: [id])
  businessId           String?                 @map("business")
  store                Store?                  @relation("CartLine_store", fields: [storeId], references: [id])
  storeId              String?                 @map("store")
  cart                 Cart?                   @relation("CartLine_cart", fields: [cartId], references: [id])
  cartId               String?                 @map("cart")
  variant              ProductVariant?         @relation("CartLine_variant", fields: [variantId], references: [id])
  variantId            String?                 @map("variant")
  barcode              ProductBarcode?         @relation("CartLine_barcode", fields: [barcodeId], references: [id])
  barcodeId            String?                 @map("barcode")
  priceBookEntry       PriceBookEntry?         @relation("CartLine_priceBookEntry", fields: [priceBookEntryId], references: [id])
  priceBookEntryId     String?                 @map("priceBookEntry")
  titleSnapshot        String                  @default("")
  variantTitleSnapshot String                  @default("")
  skuSnapshot          String                  @default("")
  barcodeSnapshot      String                  @default("")
  quantity             Decimal                 @postgresql.Decimal(18, 4)
  unitOfMeasure        String                  @default("each")
  unitPriceCents       Int
  subtotalCents        Int
  discountCents        Int                     @default(0)
  taxRate              Float?                  @default(0)
  taxInclusive         Boolean                 @default(false)
  taxCents             Int                     @default(0)
  totalCents           Int
  priceSource          CartLinePriceSourceType @default(price_book)
  ageRestricted        Boolean                 @default(false)
  minimumAge           Int?
  promotions           Promotion[]             @relation("CartLine_promotions")
  notes                String                  @default("")
  metadata             Json?                   @default("{}")
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @default(now()) @updatedAt

  @@index([businessId])
  @@index([storeId])
  @@index([cartId])
  @@index([variantId])
  @@index([barcodeId])
  @@index([priceBookEntryId])
}

model Sale {
  id                           String                @id @default(cuid())
  business                     Business?             @relation("Sale_business", fields: [businessId], references: [id])
  businessId                   String?               @map("business")
  store                        Store?                @relation("Sale_store", fields: [storeId], references: [id])
  storeId                      String?               @map("store")
  receiptNumber                String                @unique @default("")
  source                       SaleSourceType
  status                       SaleStatusType        @default(open)
  currencyCode                 String                @default("USD")
  subtotalCents                Int
  discountCents                Int                   @default(0)
  taxCents                     Int                   @default(0)
  roundingCents                Int                   @default(0)
  totalCents                   Int
  refundedCents                Int                   @default(0)
  cart                         Cart?                 @relation("Cart_sale")
  registerSession              RegisterSession?      @relation("Sale_registerSession", fields: [registerSessionId], references: [id])
  registerSessionId            String?               @map("registerSession")
  cashier                      Employee?             @relation("Sale_cashier", fields: [cashierId], references: [id])
  cashierId                    String?               @map("cashier")
  customer                     User?                 @relation("Sale_customer", fields: [customerId], references: [id])
  customerId                   String?               @map("customer")
  loyaltyAccount               LoyaltyAccount?       @relation("Sale_loyaltyAccount", fields: [loyaltyAccountId], references: [id])
  loyaltyAccountId             String?               @map("loyaltyAccount")
  lines                        SaleLine[]            @relation("SaleLine_sale")
  tenders                      Tender[]              @relation("Tender_sale")
  refunds                      Refund[]              @relation("Refund_sale")
  returns                      Return[]              @relation("Return_sale")
  promotionRedemptions         PromotionRedemption[] @relation("PromotionRedemption_sale")
  loyaltyEntries               LoyaltyLedgerEntry[]  @relation("LoyaltyLedgerEntry_sale")
  ageVerifications             AgeVerification[]     @relation("AgeVerification_sale")
  startedAt                    DateTime              @default(now())
  completedAt                  DateTime?
  voidedAt                     DateTime?
  idempotency                  IdempotencyKey?       @relation("Sale_idempotency", fields: [idempotencyId], references: [id])
  idempotencyId                String?               @map("idempotency")
  metadata                     Json?                 @default("{}")
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @default(now()) @updatedAt
  from_CashMovement_sale       CashMovement[]        @relation("CashMovement_sale")
  from_ComplianceIncident_sale ComplianceIncident[]  @relation("ComplianceIncident_sale")
  from_FuelTransaction_sale    FuelTransaction[]     @relation("FuelTransaction_sale")

  @@index([businessId])
  @@index([storeId])
  @@index([registerSessionId])
  @@index([cashierId])
  @@index([customerId])
  @@index([loyaltyAccountId])
  @@index([idempotencyId])
}

model SaleLine {
